# Copy to .env and load it however you like (docker, systemd, `set -a; . ./.env`).

# Shown in the authenticator app.
TARDIS_ISSUER=tardis-net
TARDIS_ACCOUNT=operator

# Name of the machine the console powers on and off.
TARDIS_MACHINE=tardis

# Where the JSON state document lives.
TARDIS_STATE_FILE=./data/state.json

# Signs the session cookie. Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# Leave unset and one is generated on first boot and stored in the state file.
TARDIS_SECRET_KEY=

# Session lifetime in seconds (default: 12 hours).
TARDIS_SESSION_MAX_AGE=43200
# Set to true once the console is served over HTTPS.
TARDIS_COOKIE_SECURE=false

# Brute-force guard on the code form.
TARDIS_MAX_ATTEMPTS=5
TARDIS_LOCKOUT_SECONDS=300

# How long the simulated boot / shutdown takes, in seconds.
TARDIS_TRANSITION_SECONDS=8
